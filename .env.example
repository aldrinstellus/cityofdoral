# City of Doral Chatbot - Environment Variables
# Copy this file to .env.local and fill in the values

# OpenAI API Key (Required for chatbot)
OPENAI_API_KEY=sk-...

# Anthropic API Key (Primary LLM - Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Twilio (SMS & IVR)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DORAL_CITY_HALL_PHONE=+13055934700

# Meta Platforms (Facebook, Instagram, WhatsApp)
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===========================================
# CRM Integration (ITN 3.1.2 - Optional)
# ===========================================
# Choose provider: 'salesforce', 'dynamics', or 'none'
CRM_PROVIDER=none
CRM_ENABLED=false

# Salesforce Configuration
SALESFORCE_INSTANCE_URL=https://yourorg.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# Microsoft Dynamics 365 Configuration
DYNAMICS_ORGANIZATION_URL=https://yourorg.crm.dynamics.com
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=

# ===========================================
# SharePoint Integration (ITN 3.2.5 - Optional)
# ===========================================
SHAREPOINT_ENABLED=false
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=cityofdoral.sharepoint.com
SHAREPOINT_SITE_NAME=DoralDocs
SHAREPOINT_LIBRARY_NAME=Documents
